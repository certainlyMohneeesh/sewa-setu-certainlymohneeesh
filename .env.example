# Template for the private .env that docker compose reads. Copy to .env and fill
# in, or run `sh scripts/gen-env.sh` to generate strong random values.
# .env is git-ignored; never commit real values.

# Postgres password (used by the db container and by the app / scheduler).
POSTGRES_PASSWORD=

# Flask session-signing key: at least 32 random characters.
SECRET_KEY=

# Departmental (/admin) login.
ADMIN_USERNAME=swd-admin
ADMIN_PASSWORD=
